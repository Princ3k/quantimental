# ---------------------------------------------------------------------------
# Quantimental backend configuration
#
# Copy to .env and fill in what you need:
#     cp env.example .env
#
# EVERY setting below is optional. With an empty .env the API still starts and
# serves live signals from market data — the keys unlock extra sources.
# ---------------------------------------------------------------------------

# --- Application ---
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API.
# Add every site that embeds a Quantimental panel, including the portfolio's
# Signal Desk. Vercel preview deployments are matched by pattern already.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://atifkhan.xyz,https://www.atifkhan.xyz

# --- Database (optional) ---
# Needed only for the news archive, Reddit caching and the batch pipeline.
# Matches the docker-compose.yml at the repository root.
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/quantimental

# --- Sentiment sources ---
# News sentiment works with NO keys at all: Yahoo Finance headlines are the
# default source and cover every market yfinance does. Everything below adds
# to that, and a missing key disables its source rather than breaking a request.

# Reddit — https://www.reddit.com/prefs/apps (create a "script" app; free)
#
# Strongly recommended. Reddit now allows anonymous clients roughly ONE request
# per minute — measured, not guessed — so without credentials the Reddit source
# is best-effort and will usually report itself as rate limited. A free app
# raises that to about 100/minute and also returns post scores, which the
# public RSS feeds omit. Only the ID and secret are used; the username and
# password below are for the legacy Kafka pipeline.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# MarketAux financial news — https://www.marketaux.com
# Adds publisher-scored sentiment per company on top of the Yahoo headlines.
# Free tier is 100 requests/day; past that the source reports HTTP 429 rather
# than silently returning nothing.
MARKETAUX_API_KEY=

# Twitter/X — optional, and the least important of the four sources.
#
# Two resellers are supported, and they are different companies whose keys are
# not interchangeable: a key from one gets a bare HTTP 401 from the other, with
# nothing in the error to say so. This file used to name twitterapi.io while
# the code called scrapebadger.com, which is exactly how that happens.
#
# Set the provider to wherever you actually bought the key.
#   twitterapi.io  — https://twitterapi.io   (default)
#   scrapebadger   — https://scrapebadger.com
TWITTER_API_PROVIDER=twitterapi.io
TWITTER_API_KEY=

# Groq, for LLM-based sentiment and market narratives — https://console.groq.com
GROQ_API_KEY=
# Groq retires hosted models periodically; override here if the default 404s.
# Current catalogue: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b

# Hugging Face, only needed for gated/private models
HF_TOKEN=

# --- Kafka (optional, for the async sentiment pipeline) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Scoring weights ---
# How much the chart versus the crowd counts toward the final score.
TECHNICAL_WEIGHT=0.45
SENTIMENT_WEIGHT=0.55
