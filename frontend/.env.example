# Base URL of the Quantimental API.
#
# Local development points at the backend running on your machine.
# In production set this to the deployed API, e.g.
#   https://quantimental-production.up.railway.app
#
# The API must allow this site's origin: add it to CORS_ORIGINS on the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
